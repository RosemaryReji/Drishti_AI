# ==============================================================================
# Drishti AI - Environment Configuration Template (.env.example)
# ==============================================================================

# General
PROJECT_NAME="Drishti AI"
ENVIRONMENT=development

# PostgreSQL + PostGIS Configurations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=drishtipassword123
POSTGRES_DB=drishti_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configurations (Cache, Sessions, Celery Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Kafka Configurations
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OpenSearch Configurations
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=AdminPassword123!

# Novu Notifications Configuration
NOVU_API_KEY=your_novu_api_key_here

# AI Microservices URLs
INDIC_TRANS_URL=http://localhost:8001
KOKORO_TTS_URL=http://localhost:8002
COQUI_TTS_URL=http://localhost:8003
